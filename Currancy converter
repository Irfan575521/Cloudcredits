rates = {
    "USD": 1.0,
    "INR": 83.0,
    "EUR": 0.92
}

amount = float(input("Enter amount: "))
from_cur = input("From (USD/INR/EUR): ").upper()
to_cur = input("To (USD/INR/EUR): ").upper()

if from_cur in rates and to_cur in rates:
    converted = amount / rates[from_cur] * rates[to_cur]
    print("Converted Amount:", converted)
else:
    print("Invalid currency")
